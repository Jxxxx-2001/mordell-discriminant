theorem checked : densePadCheck (((inwardPolynomial exactMajorant).dense.shiftU 0).shiftV 1 |>.shiftT 0) polynomial=true := by decide +kernel

theorem polynomial_real (x : Fin 3 → ℝ) : polynomial.real (x 0-center 0) (x 1-center 1) (x 2-center 2)=distance x*eval3 exactMajorant.du x-1 := by
  have h := densePadCheck_sound _ _ checked (x 0-center 0) (x 1-center 1) (x 2-center 2)
  rw [DenseKernel.shiftT_real,DenseKernel.shiftV_real,DenseKernel.shiftU_real,ExactKernel.dense_real] at h
  have he : polynomial.real (x 0-center 0) (x 1-center 1) (x 2-center 2)=eval3 (inwardPolynomial exactMajorant) x := by
    simpa [center,eval3,Matrix.cons_val_two] using h.symm
  rw [he,inwardPolynomial_real]

theorem bound_checked : 0≤(polynomial.bound largeRadius).lo := by decide +kernel

theorem gradient_nonneg {x : Fin 3 → ℝ} (hn : Near center largeRadius x) : 0≤gradient exactMajorant x 0 := by
  have h := DenseKernel.bound_sound largeRadius polynomial _ _ _ (hn 0) (hn 1) (hn 2)
  rw [polynomial_real] at h
  have hl : (0:ℝ)≤((polynomial.bound largeRadius).lo:ℝ) := by exact_mod_cast bound_checked
  have hp := near_distance_pos large_distance_pos hn
  have hd : 1/distance x≤eval3 exactMajorant.du x := (div_le_iff₀ hp).mpr (by nlinarith [hl.trans h.1])
  simpa [gradient,partialPoly,dd] using sub_nonneg.mpr hd
#print axioms gradient_nonneg
end N7.Kernel.Local.C0Inward
