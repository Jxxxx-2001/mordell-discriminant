theorem valid : TensorLower (fun x => exactMajorant.real (x 0) (x 1) (x 2)) box (decode controls) := by
  have h := TensorLower.integer_step N2199.valid N2199.widths N2199.shape 2 false
  rw [checked,box_eq] at h
  exact h
theorem widths : box.Widths := by
  rw [←box_eq]
  exact ClosedBox.half_widths N2199.widths 2 false
theorem shape : (decode controls).Shape 12 12 6 := RationalCube.shapeCheck_sound _ _ _ _ (by decide +kernel)
end N2500

end N7.Kernel.TreeSteps
