theorem bound : Cover.BoxMajorant TreeSteps.N1880.box := by
  intro x hx hd _
  exact SeparableCubic.majorant TreeSteps.N1880.widths TreeSteps.N1880.valid Cover.Anchors.a6 Cover.Anchors.l6 mu scaleA terms coefficients partialU partialV coefficients_checked partialU_checked partialV_checked (by decide +kernel) Cover.Anchors.pos6 Cover.Anchors.log6 (by decide +kernel) identity positive_checked x hx (lt_of_lt_of_le (by norm_num) hd.2.2.2.2.2) hd.2.2.2.2.1
