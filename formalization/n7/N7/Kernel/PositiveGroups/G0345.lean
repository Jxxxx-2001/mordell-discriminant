theorem bound : Cover.BoxMajorant TreeSteps.N3371.box := by
  intro x hx hd _
  exact SeparableCubic.majorant TreeSteps.N3371.widths TreeSteps.N3371.valid Cover.Anchors.a24 Cover.Anchors.l24 mu scaleA terms coefficients partialU partialV coefficients_checked partialU_checked partialV_checked (by decide +kernel) Cover.Anchors.pos24 Cover.Anchors.log24 (by decide +kernel) identity positive_checked x hx (lt_of_lt_of_le (by norm_num) hd.2.2.2.2.2) hd.2.2.2.2.1
