namespace N7.Kernel.PositiveLeaves.L125
open N7.Kernel SeparableCubic
set_option maxHeartbeats 0
set_option maxRecDepth 64000
def scaleA : Int := 3
def mu : ℚ := 0
def terms : List CubicLeaf.Term := [⟨(1425379595511103462870687),0,0,0⟩,⟨(1208928196396535179640832),0,0,1⟩,⟨(201391981504414347165696),0,0,2⟩,⟨(46478952002756032856064),0,0,3⟩,⟨(-604464098198267589820416),0,1,0⟩,⟨(-201391981504414347165696),0,1,1⟩,⟨(-69718428004134049284096),0,1,2⟩,⟨(50347995376103586791424),0,2,0⟩,⟨(34859214002067024642048),0,2,1⟩,⟨(-5809869000344504107008),0,3,0⟩,⟨(-604464098198267589820416),1,0,0⟩,⟨(-201391981504414347165696),1,0,1⟩,⟨(-69718428004134049284096),1,0,2⟩,⟨(100695990752207173582848),1,1,0⟩,⟨(69718428004134049284096),1,1,1⟩,⟨(-17429607001033512321024),1,2,0⟩,⟨(50347995376103586791424),2,0,0⟩,⟨(34859214002067024642048),2,0,1⟩,⟨(-17429607001033512321024),2,1,0⟩,⟨(-5809869000344504107008),3,0,0⟩]
def coefficients : SeparableCubic.Coeff := SeparableCubic.decodeCoeff 81 604464098198267589820416 
def partialU : SeparableCubic.StageU := SeparableCubic.decodeU 91 515663496477896576386203648 [,,,,,,,,,,,,]
def partialV : SeparableCubic.StageV := SeparableCubic.decodeV 100 0 [,,,,,,,,,,,,]
theorem coefficients_checked : ∀ e f g, coefficients e f g=coeff terms e f g := by decide +kernel
theorem partialU_checked : ∀ i f g, partialU i f g=computeU coefficients i f g := by decide +kernel
theorem partialV_checked : ∀ i j g, partialV i j g=computeV partialU i j g := by decide +kernel
theorem identity (x y z : ℝ) : CubicLeaf.value x y z terms = -((scaleA:ℝ)*2^80)*(CubicLeaf.upper Cover.Anchors.l16 (CubicLeaf.dist TreeSteps.N1835.box x y z/Cover.Anchors.a16-1)+(mu:ℝ)*CubicLeaf.gram TreeSteps.N1835.box x y z) := by
  norm_num [terms, CubicLeaf.value, CubicLeaf.upper, CubicLeaf.dist, CubicLeaf.gram, TreeSteps.N1835.box, Cover.Anchors.a16, Cover.Anchors.l16, scaleA, mu, Matrix.cons_val_two]
  <;> ring
theorem positive_checked : IntegerCube.nonneg (SeparableCubic.gap TreeSteps.N1835.controls scaleA partialV)=true := by decide +kernel
theorem bound : Cover.BoxMajorant TreeSteps.N1835.box := by
  intro x hx hd _
  exact SeparableCubic.majorant TreeSteps.N1835.widths TreeSteps.N1835.valid Cover.Anchors.a16 Cover.Anchors.l16 mu scaleA terms coefficients partialU partialV coefficients_checked partialU_checked partialV_checked (by decide +kernel) Cover.Anchors.pos16 Cover.Anchors.log16 (by decide +kernel) identity positive_checked x hx (lt_of_lt_of_le (by norm_num) hd.2.2.2.2.2) hd.2.2.2.2.1
end N7.Kernel.PositiveLeaves.L125
