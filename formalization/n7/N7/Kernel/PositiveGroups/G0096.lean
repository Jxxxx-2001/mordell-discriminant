def partialV : SeparableCubic.StageV := SeparableCubic.decodeV 102 0 [,,,,,,,,,,,,]
theorem coefficients_checked : ∀ e f g, coefficients e f g=coeff terms e f g := by decide +kernel
theorem partialU_checked : ∀ i f g, partialU i f g=computeU coefficients i f g := by decide +kernel
theorem partialV_checked : ∀ i j g, partialV i j g=computeV partialU i j g := by decide +kernel
theorem identity (x y z : ℝ) : CubicLeaf.value x y z terms = -((scaleA:ℝ)*2^80)*(CubicLeaf.upper Cover.Anchors.l6 (CubicLeaf.dist TreeSteps.N1850.box x y z/Cover.Anchors.a6-1)+(mu:ℝ)*CubicLeaf.gram TreeSteps.N1850.box x y z) := by
  norm_num [terms, CubicLeaf.value, CubicLeaf.upper, CubicLeaf.dist, CubicLeaf.gram, TreeSteps.N1850.box, Cover.Anchors.a6, Cover.Anchors.l6, scaleA, mu, Matrix.cons_val_two]
  <;> ring
theorem positive_checked : IntegerCube.nonneg (SeparableCubic.gap TreeSteps.N1850.controls scaleA partialV)=true := by decide +kernel
theorem bound : Cover.BoxMajorant TreeSteps.N1850.box := by
  intro x hx hd _
  exact SeparableCubic.majorant TreeSteps.N1850.widths TreeSteps.N1850.valid Cover.Anchors.a6 Cover.Anchors.l6 mu scaleA terms coefficients partialU partialV coefficients_checked partialU_checked partialV_checked (by decide +kernel) Cover.Anchors.pos6 Cover.Anchors.log6 (by decide +kernel) identity positive_checked x hx (lt_of_lt_of_le (by norm_num) hd.2.2.2.2.2) hd.2.2.2.2.1
end N7.Kernel.PositiveLeaves.L67
