namespace N7.Kernel.PositiveLeaves.L988
open N7.Kernel SeparableCubic
set_option maxHeartbeats 0
set_option maxRecDepth 64000
def scaleA : Int := 3
def mu : ℚ := 0
def terms : List CubicLeaf.Term := [⟨(5572890309388906004480),0,0,0⟩,⟨(51081372474871558176768),0,0,1⟩,⟨(359725434904095227904),0,0,2⟩,⟨(3362192708532699136),0,0,3⟩,⟨(-25540686237435779088384),0,1,0⟩,⟨(-359725434904095227904),0,1,1⟩,⟨(-5043289062799048704),0,1,2⟩,⟨(89931358726023806976),0,2,0⟩,⟨(2521644531399524352),0,2,1⟩,⟨(-420274088566587392),0,3,0⟩,⟨(-25540686237435779088384),1,0,0⟩,⟨(-359725434904095227904),1,0,1⟩,⟨(-5043289062799048704),1,0,2⟩,⟨(179862717452047613952),1,1,0⟩,⟨(5043289062799048704),1,1,1⟩,⟨(-1260822265699762176),1,2,0⟩,⟨(89931358726023806976),2,0,0⟩,⟨(2521644531399524352),2,0,1⟩,⟨(-1260822265699762176),2,1,0⟩,⟨(-420274088566587392),3,0,0⟩]
def coefficients : SeparableCubic.Coeff := SeparableCubic.decodeCoeff 77 25540686237435779088384 
def partialU : SeparableCubic.StageU := SeparableCubic.decodeU 86 23516762280603610830077952 [,,,,,,,,,,,,]
def partialV : SeparableCubic.StageV := SeparableCubic.decodeV 96 16975043646645669694506270720 [,,,,,,,,,,,,]
theorem coefficients_checked : ∀ e f g, coefficients e f g=coeff terms e f g := by decide +kernel
theorem partialU_checked : ∀ i f g, partialU i f g=computeU coefficients i f g := by decide +kernel
theorem partialV_checked : ∀ i j g, partialV i j g=computeV partialU i j g := by decide +kernel
theorem identity (x y z : ℝ) : CubicLeaf.value x y z terms = -((scaleA:ℝ)*2^80)*(CubicLeaf.upper Cover.Anchors.l14 (CubicLeaf.dist TreeSteps.N4594.box x y z/Cover.Anchors.a14-1)+(mu:ℝ)*CubicLeaf.gram TreeSteps.N4594.box x y z) := by
  norm_num [terms, CubicLeaf.value, CubicLeaf.upper, CubicLeaf.dist, CubicLeaf.gram, TreeSteps.N4594.box, Cover.Anchors.a14, Cover.Anchors.l14, scaleA, mu, Matrix.cons_val_two]
  <;> ring
theorem positive_checked : IntegerCube.nonneg (SeparableCubic.gap TreeSteps.N4594.controls scaleA partialV)=true := by decide +kernel
theorem bound : Cover.BoxMajorant TreeSteps.N4594.box := by
  intro x hx hd _
  exact SeparableCubic.majorant TreeSteps.N4594.widths TreeSteps.N4594.valid Cover.Anchors.a14 Cover.Anchors.l14 mu scaleA terms coefficients partialU partialV coefficients_checked partialU_checked partialV_checked (by decide +kernel) Cover.Anchors.pos14 Cover.Anchors.log14 (by decide +kernel) identity positive_checked x hx (lt_of_lt_of_le (by norm_num) hd.2.2.2.2.2) hd.2.2.2.2.1
end N7.Kernel.PositiveLeaves.L988
