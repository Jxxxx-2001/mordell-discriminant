def scaleA : Int := 3
def mu : ℚ := 0
def terms : List CubicLeaf.Term := [⟨(11676873148112467908803413),0,0,0⟩,⟨(39170259087972630930653184),0,0,1⟩,⟨(70508378968657765588795392),0,0,2⟩,⟨(56408233304678136467685376),0,0,3⟩,⟨(-9792564771993157732663296),0,1,0⟩,⟨(-35254189484328882794397696),0,1,1⟩,⟨(-42306174978508602350764032),0,1,2⟩,⟨(4406773685541110349299712),0,2,0⟩,⟨(10576543744627150587691008),0,2,1⟩,⟨(-881378645385595882307584),0,3,0⟩,⟨(-9792564771993157732663296),1,0,0⟩,⟨(-35254189484328882794397696),1,0,1⟩,⟨(-42306174978508602350764032),1,0,2⟩,⟨(8813547371082220698599424),1,1,0⟩,⟨(21153087489254301175382016),1,1,1⟩,⟨(-2644135936156787646922752),1,2,0⟩,⟨(4406773685541110349299712),2,0,0⟩,⟨(10576543744627150587691008),2,0,1⟩,⟨(-2644135936156787646922752),2,1,0⟩,⟨(-881378645385595882307584),3,0,0⟩]
