namespace N7.Kernel.PositiveLeaves.L401
open N7.Kernel SeparableCubic
set_option maxHeartbeats 0
set_option maxRecDepth 64000
def scaleA : Int := 3
def mu : ℚ := 0
def terms : List CubicLeaf.Term := [⟨(2381708886341698508800),0,0,0⟩,⟨(6379555774525543673856),0,0,1⟩,⟨(5610859746425708544),0,0,2⟩,⟨(6566782633852928),0,0,3⟩,⟨(-3189777887262771836928),0,1,0⟩,⟨(-5610859746425708544),0,1,1⟩,⟨(-9850173950779392),0,1,2⟩,⟨(1402714936606427136),0,2,0⟩,⟨(4925086975389696),0,2,1⟩,⟨(-820847829231616),0,3,0⟩,⟨(-3189777887262771836928),1,0,0⟩,⟨(-5610859746425708544),1,0,1⟩,⟨(-9850173950779392),1,0,2⟩,⟨(2805429873212854272),1,1,0⟩,⟨(9850173950779392),1,1,1⟩,⟨(-2462543487694848),1,2,0⟩,⟨(1402714936606427136),2,0,0⟩,⟨(4925086975389696),2,0,1⟩,⟨(-2462543487694848),2,1,0⟩,⟨(-820847829231616),3,0,0⟩]
def coefficients : SeparableCubic.Coeff := SeparableCubic.decodeCoeff 74 3189777887262771836928 
def partialU : SeparableCubic.StageU := SeparableCubic.decodeU 83 2946059176363509254565888 [,,,,,,,,,,,,]
def partialV : SeparableCubic.StageV := SeparableCubic.decodeV 93 839186749376501172373241856 [,,,,,,,,,,,,]
theorem coefficients_checked : ∀ e f g, coefficients e f g=coeff terms e f g := by decide +kernel
theorem partialU_checked : ∀ i f g, partialU i f g=computeU coefficients i f g := by decide +kernel
theorem partialV_checked : ∀ i j g, partialV i j g=computeV partialU i j g := by decide +kernel
theorem identity (x y z : ℝ) : CubicLeaf.value x y z terms = -((scaleA:ℝ)*2^80)*(CubicLeaf.upper Cover.Anchors.l14 (CubicLeaf.dist TreeSteps.N4958.box x y z/Cover.Anchors.a14-1)+(mu:ℝ)*CubicLeaf.gram TreeSteps.N4958.box x y z) := by
  norm_num [terms, CubicLeaf.value, CubicLeaf.upper, CubicLeaf.dist, CubicLeaf.gram, TreeSteps.N4958.box, Cover.Anchors.a14, Cover.Anchors.l14, scaleA, mu, Matrix.cons_val_two]
  <;> ring
theorem positive_checked : IntegerCube.nonneg (SeparableCubic.gap TreeSteps.N4958.controls scaleA partialV)=true := by decide +kernel
theorem bound : Cover.BoxMajorant TreeSteps.N4958.box := by
  intro x hx hd _
  exact SeparableCubic.majorant TreeSteps.N4958.widths TreeSteps.N4958.valid Cover.Anchors.a14 Cover.Anchors.l14 mu scaleA terms coefficients partialU partialV coefficients_checked partialU_checked partialV_checked (by decide +kernel) Cover.Anchors.pos14 Cover.Anchors.log14 (by decide +kernel) identity positive_checked x hx (lt_of_lt_of_le (by norm_num) hd.2.2.2.2.2) hd.2.2.2.2.1
end N7.Kernel.PositiveLeaves.L401
