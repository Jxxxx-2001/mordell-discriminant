def coefficients : SeparableCubic.Coeff := SeparableCubic.decodeCoeff 75 6419073122012317728768 
def partialU : SeparableCubic.StageU := SeparableCubic.decodeU 85 5925979556481629912924160 [,,,,,,,,,,,,]
def partialV : SeparableCubic.StageV := SeparableCubic.decodeV 94 0 [,,,,,,,,,,,,]
theorem coefficients_checked : ∀ e f g, coefficients e f g=coeff terms e f g := by decide +kernel
theorem partialU_checked : ∀ i f g, partialU i f g=computeU coefficients i f g := by decide +kernel
theorem partialV_checked : ∀ i j g, partialV i j g=computeV partialU i j g := by decide +kernel
theorem identity (x y z : ℝ) : CubicLeaf.value x y z terms = -((scaleA:ℝ)*2^80)*(CubicLeaf.upper Cover.Anchors.l14 (CubicLeaf.dist TreeSteps.N4847.box x y z/Cover.Anchors.a14-1)+(mu:ℝ)*CubicLeaf.gram TreeSteps.N4847.box x y z) := by
  norm_num [terms, CubicLeaf.value, CubicLeaf.upper, CubicLeaf.dist, CubicLeaf.gram, TreeSteps.N4847.box, Cover.Anchors.a14, Cover.Anchors.l14, scaleA, mu, Matrix.cons_val_two]
  <;> ring
theorem positive_checked : IntegerCube.nonneg (SeparableCubic.gap TreeSteps.N4847.controls scaleA partialV)=true := by decide +kernel
theorem bound : Cover.BoxMajorant TreeSteps.N4847.box := by
  intro x hx hd _
  exact SeparableCubic.majorant TreeSteps.N4847.widths TreeSteps.N4847.valid Cover.Anchors.a14 Cover.Anchors.l14 mu scaleA terms coefficients partialU partialV coefficients_checked partialU_checked partialV_checked (by decide +kernel) Cover.Anchors.pos14 Cover.Anchors.log14 (by decide +kernel) identity positive_checked x hx (lt_of_lt_of_le (by norm_num) hd.2.2.2.2.2) hd.2.2.2.2.1
end N7.Kernel.PositiveLeaves.L409
