theorem bound : Cover.BoxMajorant TreeSteps.N4634.box := by
  intro x hx hd _
  exact SeparableCubic.majorant TreeSteps.N4634.widths TreeSteps.N4634.valid Cover.Anchors.a14 Cover.Anchors.l14 mu scaleA terms coefficients partialU partialV coefficients_checked partialU_checked partialV_checked (by decide +kernel) Cover.Anchors.pos14 Cover.Anchors.log14 (by decide +kernel) identity positive_checked x hx (lt_of_lt_of_le (by norm_num) hd.2.2.2.2.2) hd.2.2.2.2.1
