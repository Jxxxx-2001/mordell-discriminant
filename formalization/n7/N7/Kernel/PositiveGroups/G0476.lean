def partialV : SeparableCubic.StageV := SeparableCubic.decodeV 96 16975043646645669694506270720 [,,,,,,,,,,,,]
theorem coefficients_checked : ∀ e f g, coefficients e f g=coeff terms e f g := by decide +kernel
theorem partialU_checked : ∀ i f g, partialU i f g=computeU coefficients i f g := by decide +kernel
theorem partialV_checked : ∀ i j g, partialV i j g=computeV partialU i j g := by decide +kernel
theorem identity (x y z : ℝ) : CubicLeaf.value x y z terms = -((scaleA:ℝ)*2^80)*(CubicLeaf.upper Cover.Anchors.l14 (CubicLeaf.dist TreeSteps.N4634.box x y z/Cover.Anchors.a14-1)+(mu:ℝ)*CubicLeaf.gram TreeSteps.N4634.box x y z) := by
  norm_num [terms, CubicLeaf.value, CubicLeaf.upper, CubicLeaf.dist, CubicLeaf.gram, TreeSteps.N4634.box, Cover.Anchors.a14, Cover.Anchors.l14, scaleA, mu, Matrix.cons_val_two]
  <;> ring
