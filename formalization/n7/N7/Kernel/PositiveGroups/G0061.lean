namespace N7.Kernel.PositiveLeaves.L6
open N7.Kernel SeparableCubic
set_option maxHeartbeats 0
set_option maxRecDepth 64000
def scaleA : Int := 3
def mu : ℚ := 0
def terms : List CubicLeaf.Term := [⟨(2885254998732230321499211),0,0,0⟩,⟨(3782324357583898335510528),0,0,1⟩,⟨(991282007938339977560064),0,0,2⟩,⟨(2974652928176386102788096),0,0,3⟩,⟨(-945581089395974583877632),0,1,0⟩,⟨(-495641003969169988780032),0,1,1⟩,⟨(-2230989696132289577091072),0,1,2⟩,⟨(61955125496146248597504),0,2,0⟩,⟨(557747424033072394272768),0,2,1⟩,⟨(-46478952002756032856064),0,3,0⟩,⟨(-945581089395974583877632),1,0,0⟩,⟨(-495641003969169988780032),1,0,1⟩,⟨(-2230989696132289577091072),1,0,2⟩,⟨(123910250992292497195008),1,1,0⟩,⟨(1115494848066144788545536),1,1,1⟩,⟨(-139436856008268098568192),1,2,0⟩,⟨(61955125496146248597504),2,0,0⟩,⟨(557747424033072394272768),2,0,1⟩,⟨(-139436856008268098568192),2,1,0⟩,⟨(-46478952002756032856064),3,0,0⟩]
