theorem ratio_substitution (b d : K) (hb : b ≠ 0) : b * (d / b) = d := by

  field_simp

theorem saturation (B c k e : K) (hB : B ≠ 0) (hD : D B c k e ≠ 0) :

    (B * D B c k e)⁻¹ * B * D B c k e - 1 = 0 := by

  field_simp <;> ring

theorem nonsingular_of_saturation (t B c k e : K)

    (h : t * B * D B c k e - 1 = 0) : B ≠ 0 ∧ D B c k e ≠ 0 := by

  constructor <;> intro hz <;> simp [hz] at h

end N6.Chart

