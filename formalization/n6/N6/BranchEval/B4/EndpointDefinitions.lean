def physicalSquare (a D : K) : K := a^15*D^2/(5^30 : K)
theorem literal_field (x : Fin 5 → K) (z d : Int) : meaning x (litNF z d) = (z : K)/(d : K) := by
  simp only [literal_value, map_inv₀, map_intCast, div_eq_mul_inv]
  ring
theorem value_coefScale (x : Fin 5 → K) (z : Int) (p : Poly) : value x (coefScale z p) = (z : K)*value x p := by
  induction p with
  | nil => simp [coefScale, value]
  | cons a p ih => simp only [coefScale, List.map_cons, value, Int.cast_mul] at ih ⊢; rw [ih]; ring
theorem value_unitPoly (x : Fin 5 → K) : value x unitPoly = 1 := by simp [unitPoly, value, monVal]
theorem inputB_value (x : Fin 5 → K) : B x = x 4 := by
  apply input_of_projection x input0NF (x 4) input0_den_ne_zero
  simp [input0NF, input0Num, input0NumPart0, pm1, value, monVal]
end N6.BranchEval.B4.ProgramData
