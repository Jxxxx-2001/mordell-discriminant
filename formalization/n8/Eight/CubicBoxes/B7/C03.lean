    -((81:Int):ℝ)*2^80*CubicLeaf.upper hi (CubicLeaf.dist box u v t/a-1) := by
  norm_num [terms,CubicLeaf.value,CubicLeaf.dist,CubicLeaf.upper,box,a,hi,Matrix.cons_val_two] <;> ring
theorem checked : IntegerCube.nonneg (CubicLeaf.gap S2L0L1R2R0R1L2L0L1L2R.controls 81 terms)=true := by decide +kernel
theorem bound : BoxMajorant box :=
  CubicLeaf.majorant S2L0L1R2R0R1L2L0L1L2R.widths S2L0L1R2R0R1L2L0L1L2R.valid a hi 81 terms
    (by norm_num) (by norm_num [a]) log_upper (fun u v t => by simpa [mul_assoc] using ident u v t) checked
end Leaf5

