theorem coefficients_checked : ∀ e f g, coefficients e f g=coeff terms e f g := by decide +kernel
theorem partialU_checked : ∀ i f g, partialU i f g=computeU coefficients i f g := by decide +kernel
theorem partialV_checked : ∀ i j g, partialV i j g=computeV partialU i j g := by decide +kernel

theorem log_checked : Checks.logCheck a lo hi 32=true := by decide +kernel
theorem log_upper : Real.log (a:ℝ)≤(hi:ℝ) :=
  (Checks.logCheck_sound a lo hi 32 log_checked).2
theorem ident (u v t : ℝ) : CubicLeaf.value u v t terms=
    -(((6000:Int):ℝ)*2^80)*(CubicLeaf.upper hi (CubicLeaf.dist box u v t/a-1)+
      CubicDomainLeaf.penalty gram canonical distance
        (CubicDomainLeaf.affine box 0 u) (CubicDomainLeaf.affine box 1 v)
        (CubicDomainLeaf.affine box 2 t)) := by
  norm_num [terms,CubicLeaf.value,CubicLeaf.dist,CubicLeaf.upper,
    CubicDomainLeaf.penalty,CubicDomainLeaf.affine,box,a,hi,gram,canonical,distance,
    Matrix.cons_val_two] <;> ring
theorem checked : IntegerCube.nonneg (SeparableCubic.gap S2L0R1R2L0L1L2R0L1L2L.controls 6000 partialV)=true := by decide +kernel
theorem bound : BoxMajorant box :=
  SeparableDomainLeaf.majorant S2L0R1R2L0L1L2R0L1L2L.widths S2L0R1R2L0L1L2R0L1L2L.valid a hi 6000 terms coefficients partialU partialV coefficients_checked partialU_checked partialV_checked gram canonical distance
    (by norm_num) (by norm_num [a]) log_upper
    (by norm_num [gram]) (by norm_num [canonical]) (by norm_num [distance]) ident checked
end Leaf1

