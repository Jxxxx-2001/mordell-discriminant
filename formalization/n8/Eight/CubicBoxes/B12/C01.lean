def terms : List CubicLeaf.Term := [⟨(-10662442134747616973026267500),0,0,0⟩,⟨(478618170904488551756072100),0,0,1⟩,⟨(56829217993796287996821405),0,0,2⟩,⟨(2417851639229258349412352),0,0,3⟩,⟨(-444923519505818403434397300),0,1,0⟩,⟨(-36267774588438875241185280),0,1,1⟩,⟨(-3626777458843887524118528),0,1,2⟩,⟨(9066943647109718810296320),0,2,0⟩,⟨(1813388729421943762059264),0,2,1⟩,⟨(-302231454903657293676544),0,3,0⟩,⟨(-444923519505818403434397300),1,0,0⟩,⟨(-36267774588438875241185280),1,0,1⟩,⟨(-3626777458843887524118528),1,0,2⟩,⟨(-2427556111137975135043485),1,1,0⟩,⟨(3626777458843887524118528),1,1,1⟩,⟨(-906694364710971881029632),1,2,0⟩,⟨(9066943647109718810296320),2,0,0⟩,⟨(1813388729421943762059264),2,0,1⟩,⟨(-906694364710971881029632),2,1,0⟩,⟨(-302231454903657293676544),3,0,0⟩]
