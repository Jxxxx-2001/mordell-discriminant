import Eight.RootPositive.Root
import Eight.CubicLeaf
import Eight.LocalLeaf
import Eight.PackedTensorData
namespace MordellEight.CubicBoxes.B23
open FixedTensor IntegerCube RationalCube Checks
set_option maxHeartbeats 0
set_option maxRecDepth 100000
namespace Root
def controls := RootPositive.Root.controls
def box : ClosedBox 3 := domainBox
theorem valid : TensorMinorant box (FixedTensor.decode controls) := RootPositive.Root.valid
theorem widths : box.Widths := RootPositive.Root.widths
theorem shape : (FixedTensor.decode controls).shapeCheck 12 12 6=true := RootPositive.Root.shape
end Root
namespace S2R
noncomputable def controls : FixedTensor.Cube :=
  PackedTensorData.decode 106 (47058048729339386879088811597331)
    [,
     ,
     ,
     ,
     ,
     ,
     ,
     ,
     ,
     ,
     ,
     ,
     ]
def box : ClosedBox 3 := ⟨![0,0,0],![(965267/524288),(965267/524288),(965267/524288)]⟩
theorem box_eq : Root.box.half 2 true=box := by
  apply congrArg₂ ClosedBox.mk <;> funext i <;> fin_cases i <;> decide +kernel
theorem widths : box.Widths := by
  rw [←box_eq]; exact ClosedBox.half_widths Root.widths 2 true
theorem checked : FixedTransfer.step Root.controls 2 true=controls := by
  exact of_decide_eq_true (show decide (FixedTransfer.step Root.controls 2 true=controls)=true by decide +kernel)
theorem valid : TensorMinorant box (decode controls) := by
  have h := FixedTransfer.step_valid Root.valid Root.widths (shapeCheck_sound _ _ _ _ Root.shape) 2 true
  rw [checked,box_eq] at h
  exact h
theorem shape : (decode controls).shapeCheck 12 12 6=true := by decide +kernel
end S2R

