def distance : ℚ := 0
def terms : List CubicLeaf.Term := [⟨(12403459979334199437222132),0,0,0⟩,⟨(-3948954498440217573759108),0,0,1⟩,⟨(4614016083453941917558305),0,0,2⟩,⟨(604462909807314587353088),0,0,3⟩,⟨(-3626777458843887524118528),0,1,0⟩,⟨(-1813388729421943762059264),0,1,1⟩,⟨(-906694364710971881029632),0,1,2⟩,⟨(453347182355485940514816),0,2,0⟩,⟨(453347182355485940514816),0,2,1⟩,⟨(-75557863725914323419136),0,3,0⟩,⟨(-3626777458843887524118528),1,0,0⟩,⟨(-1813388729421943762059264),1,0,1⟩,⟨(-906694364710971881029632),1,0,2⟩,⟨(-1893932989321026274469409),1,1,0⟩,⟨(906694364710971881029632),1,1,1⟩,⟨(-226673591177742970257408),1,2,0⟩,⟨(453347182355485940514816),2,0,0⟩,⟨(453347182355485940514816),2,0,1⟩,⟨(-226673591177742970257408),2,1,0⟩,⟨(-75557863725914323419136),3,0,0⟩]
