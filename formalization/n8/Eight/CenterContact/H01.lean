theorem checked : densePadCheck (exactMajorant.du.dv.dense.shiftV 1) polynomial=true := by
  decide +kernel
theorem polynomial_real (u v t : ℝ) : polynomial.real u v t=exactMajorant.du.dv.real u (v+1) t := by
