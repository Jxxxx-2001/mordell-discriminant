theorem checked : densePadCheck (exactMajorant.du.du.dense.shiftV 1) polynomial=true := by
  decide +kernel
theorem polynomial_real (u v t : ℝ) : polynomial.real u v t=exactMajorant.du.du.real u (v+1) t := by
