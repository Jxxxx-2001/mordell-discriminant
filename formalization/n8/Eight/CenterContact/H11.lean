theorem checked : densePadCheck (exactMajorant.dv.dv.dense.shiftV 1) polynomial=true := by
  decide +kernel
theorem polynomial_real (u v t : ℝ) : polynomial.real u v t=exactMajorant.dv.dv.real u (v+1) t := by
